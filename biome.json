{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "packages/**/src/**",
      "packages/**/test/**",
      "*.json",
      "*.ts",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noTemplateCurlyInString": "off" }
    }
  }
}

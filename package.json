{
  "name": "homeport",
  "private": true,
  "description": "Guided, auto-wired rollout of a self-hosted media stack and home services on Docker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @homeport/web",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:vpn": "npm run build && node scripts/e2e-vpn.mjs",
    "docker:build": "docker build -t homeport:dev .",
    "e2e:server": "npm run docker:build && node scripts/e2e-server.mjs",
    "e2e:wireguard": "npm run build && node scripts/e2e-wireguard.mjs",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "version": "0.1.0"
}
